# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/wago

# JWT
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# DeepInfra — powers all AI features (LLM + TTS + voice cloning).
# Required: the app has no other AI provider wired up.
DEEPINFRA_API_KEY=

# Email (Nodemailer - Zoho Mail)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=WaGo Training

# Frontend URL(s) allowed by CORS.
# Comma-separated for multiple origins. Trailing slashes are ignored.
# In non-production, http://localhost:5173 is always allowed as well.
FRONTEND_URL=http://localhost:5173
